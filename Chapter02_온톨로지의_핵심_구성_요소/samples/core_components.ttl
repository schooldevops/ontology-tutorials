@prefix ex: <https://example.com/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 2강 샘플: 클래스, 속성, 인스턴스를 분리해서 표현한 예제

############
# Classes
############

ex:Customer a rdfs:Class ;
    rdfs:label "고객"@ko .

ex:Product a rdfs:Class ;
    rdfs:label "상품"@ko .

ex:PhysicalProduct a rdfs:Class ;
    rdfs:subClassOf ex:Product ;
    rdfs:label "실물 상품"@ko .

ex:SubscriptionPlan a rdfs:Class ;
    rdfs:subClassOf ex:Product ;
    rdfs:label "구독 플랜"@ko .

ex:Order a rdfs:Class ;
    rdfs:label "주문"@ko .

ex:MarketingEvent a rdfs:Class ;
    rdfs:label "마케팅 이벤트"@ko .

ex:Channel a rdfs:Class ;
    rdfs:label "채널"@ko .

############
# Object Properties
############

ex:placesOrder a rdf:Property ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Order ;
    rdfs:label "주문한다"@ko .

ex:containsProduct a rdf:Property ;
    rdfs:domain ex:Order ;
    rdfs:range ex:Product ;
    rdfs:label "상품을 포함한다"@ko .

ex:participatesIn a rdf:Property ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:MarketingEvent ;
    rdfs:label "이벤트에 참여한다"@ko .

ex:hasChannel a rdf:Property ;
    rdfs:domain ex:MarketingEvent ;
    rdfs:range ex:Channel ;
    rdfs:label "채널을 가진다"@ko .

############
# Data Properties
############

ex:name a rdf:Property ;
    rdfs:label "이름"@ko .

ex:email a rdf:Property ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string ;
    rdfs:label "이메일"@ko .

ex:price a rdf:Property ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:decimal ;
    rdfs:label "가격"@ko .

ex:status a rdf:Property ;
    rdfs:domain ex:Order ;
    rdfs:range xsd:string ;
    rdfs:label "상태"@ko .

ex:orderedAt a rdf:Property ;
    rdfs:domain ex:Order ;
    rdfs:range xsd:dateTime ;
    rdfs:label "주문 시각"@ko .

############
# Instances
############

ex:U002 a ex:Customer ;
    ex:name "이서연" ;
    ex:email "seoyeon@example.com" ;
    ex:participatesIn ex:E2026_SUMMER ;
    ex:placesOrder ex:O2001 .

ex:E2026_SUMMER a ex:MarketingEvent ;
    ex:name "여름 할인 이벤트" ;
    ex:hasChannel ex:MobileApp .

ex:MobileApp a ex:Channel ;
    ex:name "모바일 앱" .

ex:P002 a ex:PhysicalProduct ;
    ex:name "무선 키보드" ;
    ex:price "59000.00"^^xsd:decimal .

ex:O2001 a ex:Order ;
    ex:status "PAID" ;
    ex:orderedAt "2026-06-01T11:20:00"^^xsd:dateTime ;
    ex:containsProduct ex:P002 .

# 확인 포인트:
# - ex:PhysicalProduct는 ex:Product의 하위 클래스다.
# - ex:U002는 ex:Customer의 인스턴스다.
# - ex:placesOrder는 고객과 주문을 연결하는 객체 속성이다.
# - ex:price는 상품과 숫자 값을 연결하는 데이터 속성이다.
