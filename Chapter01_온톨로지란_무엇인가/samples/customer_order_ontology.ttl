@prefix ex: <https://example.com/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 1강 샘플: 같은 커머스 데이터를 온톨로지 관점으로 표현한 예시
# 목적: 테이블보다 개념과 관계가 전면에 드러나는 방식을 확인한다.

ex:User a rdfs:Class ;
    rdfs:label "사용자"@ko ;
    rdfs:comment "서비스를 이용하거나 구매, 구독, 이벤트 참여를 수행하는 사람"@ko .

ex:Customer a rdfs:Class ;
    rdfs:subClassOf ex:User ;
    rdfs:label "고객"@ko .

ex:Product a rdfs:Class ;
    rdfs:label "상품"@ko .

ex:SubscriptionPlan a rdfs:Class ;
    rdfs:subClassOf ex:Product ;
    rdfs:label "구독 플랜"@ko .

ex:PhysicalProduct a rdfs:Class ;
    rdfs:subClassOf ex:Product ;
    rdfs:label "실물 상품"@ko .

ex:Order a rdfs:Class ;
    rdfs:label "주문"@ko .

ex:MarketingEvent a rdfs:Class ;
    rdfs:label "마케팅 이벤트"@ko .

ex:placesOrder a rdf:Property ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Order ;
    rdfs:label "주문한다"@ko .

ex:containsProduct a rdf:Property ;
    rdfs:domain ex:Order ;
    rdfs:range ex:Product ;
    rdfs:label "상품을 포함한다"@ko .

ex:participatesIn a rdf:Property ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:MarketingEvent ;
    rdfs:label "이벤트에 참여한다"@ko .

ex:influencedBy a rdf:Property ;
    rdfs:domain ex:Order ;
    rdfs:range ex:MarketingEvent ;
    rdfs:label "영향을 받았다"@ko .

ex:U001 a ex:Customer ;
    ex:name "김민준" ;
    ex:email "minjun@example.com" ;
    ex:participatesIn ex:E001 ;
    ex:placesOrder ex:O1001 .

ex:U002 a ex:Customer ;
    ex:name "이서연" ;
    ex:email "seoyeon@example.com" ;
    ex:placesOrder ex:O1002 .

ex:P001 a ex:SubscriptionPlan ;
    ex:name "프리미엄 구독 플랜" ;
    ex:price "29000.00"^^xsd:decimal .

ex:P002 a ex:PhysicalProduct ;
    ex:name "무선 키보드" ;
    ex:price "59000.00"^^xsd:decimal .

ex:O1001 a ex:Order ;
    ex:orderedAt "2026-05-01T10:30:00"^^xsd:dateTime ;
    ex:status "PAID" ;
    ex:containsProduct ex:P001 ;
    ex:influencedBy ex:E001 .

ex:O1002 a ex:Order ;
    ex:orderedAt "2026-05-03T14:10:00"^^xsd:dateTime ;
    ex:status "PAID" ;
    ex:containsProduct ex:P002 .

ex:E001 a ex:MarketingEvent ;
    ex:name "5월 구독 전환 캠페인" ;
    ex:channel "EMAIL" ;
    ex:startedAt "2026-05-01"^^xsd:date ;
    ex:endedAt "2026-05-31"^^xsd:date .

# 읽기 예시:
# - ex:SubscriptionPlan은 ex:Product의 하위 클래스다.
# - ex:U001은 ex:E001 이벤트에 참여했다.
# - ex:O1001은 ex:P001 상품을 포함한다.
# - ex:P001은 구독 플랜이므로 상품이면서 동시에 구독 상품이다.
